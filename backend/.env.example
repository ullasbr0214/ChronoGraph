# Neo4j Aura (optional for the local review/demo mode)
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_PASSWORD

# false = try Neo4j first and automatically fall back to local evidence on connection failure.
# true  = always use the bundled local evidence.
CHRONOGRAPH_DEMO_MODE=false
